# Copy this file to .env and add your own API keys. Never commit .env.
APP_NAME=Multimodal RAG Chatbot (Hosted APIs)
HOST=127.0.0.1
PORT=8000

# Required for semantic embeddings and multimodal image/chart understanding.
GEMINI_API_KEY=put_your_gemini_api_key_here
# Optional alternative variable name accepted by the Google SDK/API:
# GOOGLE_API_KEY=

# Required for default chat generation. Gemini is configured as fallback.
GROQ_API_KEY=put_your_groq_api_key_here
CHAT_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
ENABLE_GEMINI_FALLBACK=true
ENABLE_VISION=true

# Chunk sizes are characters, not tokens.
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250
TABLE_ROWS_PER_CHUNK=12
CANDIDATE_K=12
FINAL_TOP_K=5
RRF_CONSTANT=60
MAX_CONTEXT_CHARS=14000
REQUEST_TIMEOUT_SECONDS=90
