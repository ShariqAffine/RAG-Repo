# No hosted API keys are required for the local setup.
APP_NAME=Local Multimodal RAG Chatbot
HOST=127.0.0.1
PORT=8000

# Ollama chat/generation model. You can swap this for another installed Ollama chat model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional visual understanding for charts, infographics, photos and scanned pages.
# Pull this model before ingesting PDFs when ENABLE_VISION=true.
ENABLE_VISION=true
VISION_MODEL=qwen2.5vl:3b

# Local embedding model; downloads once on first use and is then cached locally.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Keep this disabled initially on a 16 GB CPU laptop; enable to test reranking.
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunk sizes below are characters, not tokens.
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250
TABLE_ROWS_PER_CHUNK=12
CANDIDATE_K=12
FINAL_TOP_K=5
RRF_CONSTANT=60
MAX_CONTEXT_CHARS=14000
REQUEST_TIMEOUT_SECONDS=300
